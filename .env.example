# =============================================================
# fixd — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# -------------------------------------------------------------
# LLM — Groq API (required for small model & default large)
# -------------------------------------------------------------
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional: override the default Groq model names
# SMALL_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   ← always served by Groq
# LARGE_MODEL=qwen/qwen3-32b                               ← used when DEFAULT_LLM_SERVICE=groq

# -------------------------------------------------------------
# LLM — Service routing for large model
# -------------------------------------------------------------
# "groq"     → use Groq for both small & large model calls (default)
# "clarifai" → use Groq for small, Clarifai for large
DEFAULT_LLM_SERVICE=groq

# -------------------------------------------------------------
# LLM — Clarifai (required only when DEFAULT_LLM_SERVICE=clarifai)
# -------------------------------------------------------------
# Get your PAT at: https://clarifai.com/settings/security
# CLARIFAI_PAT=your_clarifai_pat_here

# Optional: override the Clarifai large model (full model URL)
# CLARIFAI_LARGE_MODEL=https://clarifai.com/openai/chat-completion/models/gpt-oss-120b-high-throughput/versions/ce70fc95cef1411898db183e409e98d8

# -------------------------------------------------------------
# Optional: project path override (defaults to cwd)
# -------------------------------------------------------------
# PROJECT_PATH=/path/to/your/project
