# =============================================================
# fixd — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# -------------------------------------------------------------
# LLM — Groq API (required)
# -------------------------------------------------------------
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional: override the default model names
# SMALL_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# LARGE_MODEL=qwen/qwen3-32b

# -------------------------------------------------------------
# Agent server (no longer needed — ElizaOS removed)
# -------------------------------------------------------------
# FIXD_AGENT_URL=http://localhost:3000  ← deprecated, safe to delete

# -------------------------------------------------------------
# Optional: project path override (defaults to cwd)
# -------------------------------------------------------------
# PROJECT_PATH=/path/to/your/project
