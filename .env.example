# =============================================================
# fixd — Configuration
# =============================================================
# FIXD now uses an endpoint-based config system.
# Run `fixd config` to set up endpoints interactively.
# Config is stored in ~/.config/fixd/config.json
#
# Legacy env vars (below) are auto-migrated on first run.
# Set them once, run `fixd status`, and they'll be converted
# to the new endpoint format automatically.

# -------------------------------------------------------------
# Legacy — LLM provider keys (auto-migrated to config.json)
# -------------------------------------------------------------
# These are read once during migration. After migration,
# config.json is the canonical source.

# Groq — OpenAI-compatible, small/fast model
GROQ_API_KEY=your_groq_key_here

# OpenRouter — OpenAI-compatible, large model
OPENROUTER_API_KEY=your_openrouter_key_here

# Clarifai — OpenAI-compatible, fallback large model
# CLARIFAI_PAT=your_clarifai_pat_here

# -------------------------------------------------------------
# Optional: Context7 live library docs (env var, not endpoint)
# -------------------------------------------------------------
# CONTEXT7_API_KEY=your_context7_key_here

# -------------------------------------------------------------
# Optional: tuning
# -------------------------------------------------------------
# FIXD_COMMAND_TIMEOUT=120000   ← ms, default 120s
