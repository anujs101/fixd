# =============================================================
# fixd — Environment Variables
# =============================================================
# Recommended: place your keys in ~/.config/fixd/.env
# so they are never accidentally committed to any project repo.
#
#   mkdir -p ~/.config/fixd && cp .env.example ~/.config/fixd/.env
#
# fixd loads keys in this order:
#   1. ~/.config/fixd/.env   ← recommended (XDG user config)
#   2. ~/.fixd/.env          ← legacy fallback
#   3. <fixd-package>/.env   ← dev convenience (this file)

# -------------------------------------------------------------
# LLM — OpenRouter (required, used for the large model)
# -------------------------------------------------------------
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: override the OpenRouter model (default: openai/gpt-oss-120b:free)
# OPENROUTER_LARGE_MODEL=openai/gpt-oss-120b:free

# -------------------------------------------------------------
# LLM — Groq API (required, used for the small/fast model)
# -------------------------------------------------------------
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional: override the small model name
# SMALL_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# -------------------------------------------------------------
# LLM — Clarifai (fallback if OpenRouter fails)
# -------------------------------------------------------------
# Get your PAT at: https://clarifai.com/settings/security
# CLARIFAI_PAT=your_clarifai_pat_here

# Optional: override the Clarifai fallback model URL
# CLARIFAI_LARGE_MODEL=https://clarifai.com/openai/chat-completion/models/gpt-oss-120b-high-throughput/versions/ce70fc95cef1411898db183e409e98d8

# -------------------------------------------------------------
# Optional: Context7 live library docs
# -------------------------------------------------------------
# CONTEXT7_API_KEY=your_context7_key_here

# -------------------------------------------------------------
# Optional: tuning
# -------------------------------------------------------------
# FIXD_COMMAND_TIMEOUT=120000   ← ms, default 120s (increase for slow cargo/maven builds)
