{
  "name": "fixd",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fixd": "tsx cli/index.ts",
    "build": "tsc -p tsconfig.cli.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "acceptance": "vitest run --config vitest.acceptance.config.ts --no-file-parallelism",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "fixd": "./dist/cli/index.js",
    "fixd-dev": "./dist/automation/cli.js"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^16.5.0",
    "execa": "^9.6.1",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "~25.8.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
