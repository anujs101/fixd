{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": [
    "cli/**/*",
    "src/**/*",
    "automation/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
